{
  "name": "vitaliyboyko/magento-seq",
  "description": "Magento 2 local-development module forwarding Monolog and custom PHP/JavaScript events to Seq structured logging",
  "type": "magento2-module",
  "version": "2026.1.2",
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "ext-curl": "*",
    "magento/framework": "*",
    "magento/module-backend": "*",
    "magento/module-config": "*",
    "magento/module-store": "*",
    "magento/module-webapi": "*"
  },
  "license": [
    "proprietary"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "VitaliiBoiko\\Seq\\": ""
    }
  },
  "keywords": [
    "magento2",
    "seq",
    "structured-logging",
    "monolog",
    "clef",
    "instrumentation",
    "debugging"
  ],
  "homepage": "https://github.com/VitaliyBoyko/magento-seq",
  "support": {
    "issues": "https://github.com/VitaliyBoyko/magento-seq/issues",
    "source": "https://github.com/VitaliyBoyko/magento-seq"
  }
}
